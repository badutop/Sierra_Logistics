# Copiez ce fichier en docker/.env avant de lancer `docker compose up`.
# Lu par docker-compose.yml et par docker/wp-config-local.php (via getenv()
# dans le conteneur WordPress) - aucun secret réel ici, environnement de
# développement jetable.

DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=root

# Racine du proxy nginx qui reproduit la topologie de production
# (/ -> front, /gestion/ -> WordPress) sur un seul port local.
WP_HOME=http://localhost:8080
WP_SITEURL=http://localhost:8080/gestion
WP_ENVIRONMENT_TYPE=local
