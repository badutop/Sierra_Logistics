# Copiez ce fichier en migration/deploy.env (jamais commité) et complétez
# avec les identifiants SFTP fournis par OVH (espace client > Hébergement >
# FTP-SSH).

OVH_HOST=ftp.votre-domaine.sn
OVH_USER=votreloginftp
OVH_SFTP_PORT=22

# L'un des deux : mot de passe, ou chemin vers une clé SSH privée autorisée
# sur l'hébergement (recommandé, voir la doc OVH "Accès SSH").
OVH_PASSWORD=
OVH_SSH_KEY=

# Racine distante correspondant à www/ sur l'hébergement OVH (le dossier qui
# contient à la fois les fichiers du front et le sous-dossier gestion/).
OVH_REMOTE_PATH=/www
