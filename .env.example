# Domaine du site, utilisé par layout.js/sitemap.js/robots.js (jamais de
# domaine en dur dans le code, voir migration/DEPLOIEMENT.md). Mettre à jour
# lors d'un changement de domaine (sous-domaine temporaire -> définitif) et
# rebuilder : ces variables sont lues au build, pas à la requête.
NEXT_PUBLIC_SITE_URL=https://sierra-logistics-web.vercel.app
# "false" uniquement sur un sous-domaine temporaire pas encore destiné à être
# indexé. Absent ou "true" partout ailleurs, y compris en production actuelle.
NEXT_PUBLIC_ALLOW_INDEXING=true

# Base de l'API REST publique du plugin WordPress (sierra/v1). Par défaut, un
# chemin relatif (/gestion/wp-json/sierra/v1) puisque le front et WordPress
# sont servis par le même domaine : rien à définir ici dans ce cas. À ne
# renseigner que si l'API vit sur un domaine différent du front.
NEXT_PUBLIC_API_URL=
