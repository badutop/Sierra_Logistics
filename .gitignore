# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...sauf les modèles destinés à être commités et copiés par chaque
# développeur/déploiement (voir README.md, migration/DEPLOIEMENT.md).
!.env.example
!**/.env.example

# vercel
.vercel

# supabase CLI local state
supabase/.temp

# typescript
*.tsbuildinfo
next-env.d.ts

# WordPress plugin dependencies (reconstruites par composer install au déploiement,
# voir migration/DEPLOIEMENT.md - jamais committées : dev (phpunit/phpcs) et prod
# (Dompdf) n'ont pas leur place dans le dépôt)
wordpress/wp-content/plugins/*/vendor/
wordpress/**/wp-config-local.php

# Docker local (secrets de dev uniquement, mais on n'en versionne pas quand même)
docker/.env

# Identifiants SFTP de déploiement
migration/deploy.env

# Artefacts PHPUnit
wordpress/wp-content/plugins/*/.phpunit.result.cache
